{
  "name": "lumane-chat-server",
  "version": "1.0.0",
  "description": "케이트블랑 루마네 AI 상담 서버",
  "main": "server.js",
  "scripts": {
    "start": "npm run frontend:build && node server.js",
    "design:lint": "designmd lint DESIGN.md",
    "design:tokens": "node scripts/generate-design-tokens.mjs",
    "design:tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "frontend:guardrails": "node --test scripts/check-frontend-guardrails.test.mjs && node scripts/check-frontend-guardrails.mjs",
    "frontend:typecheck": "tsc -p frontend/admin/tsconfig.json --noEmit",
    "frontend:test": "vitest run --config frontend/admin/vitest.config.ts",
    "frontend:build": "vite build --config frontend/admin/vite.config.ts",
    "frontend:visual": "playwright test --config frontend/admin/playwright.config.ts",
    "frontend:verify": "npm run design:lint && npm run design:tokens:check && npm run frontend:guardrails && npm run frontend:typecheck && npm run frontend:test && npm run frontend:build",
    "test:server": "node --test test/*.test.js",
    "test:ui": "npm run frontend:test",
    "test": "npm run test:server && npm run test:ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@notionhq/client": "^2.3.0",
    "@supabase/supabase-js": "^2.101.1",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@babel/traverse": "^8.0.4",
    "@fontsource/pretendard": "5.3.0",
    "@google/design.md": "0.3.0",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "4.12.1",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
